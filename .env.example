# Server Configuration
# Port the Express server listens on
PORT=3000

# Environment: development | production
# In production, sensitive values below are required (no fallbacks)
NODE_ENV=development

# Database
# Redis connection string
REDIS_URL=redis://localhost:6379

# Admin Panel Authentication
# Required in production (no default fallback)
ADMIN_USER=admin
ADMIN_PASS=admin
SESSION_SECRET=change-this-to-a-random-string

# Rate Limiting
MOCK_RATE_LIMIT=100
MOCK_RATE_WINDOW_MS=60000
DEFAULT_SCENARIO_RATE_LIMIT=50
DEFAULT_SCENARIO_RATE_WINDOW_MS=60000

# Traffic Logging
TRAFFIC_LOG_TTL_DAYS=7
